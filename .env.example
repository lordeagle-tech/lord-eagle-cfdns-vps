# Public service runtime
PORT=3000
# Set to 127.0.0.1 when serving through a local reverse proxy such as Nginx.
# Defaults to 0.0.0.0 for container deployments.
HOST=0.0.0.0
DATABASE_URL=mysql://user:password@host:3306/database

# Required for self-hosted deployments. Use a long random value.
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Public panel origin; CORS and cookie-authenticated writes are restricted to this origin.
APP_ORIGIN=https://panel.example.com
# lax is recommended for a standalone self-hosted panel; use none only when embedded cross-site.
SESSION_COOKIE_SAME_SITE=lax
# Optional comma-separated extra frontend origins. Leave empty for a single-origin deployment.
APP_ALLOWED_ORIGINS=

# SSH/SFTP controls are blocked outside production; set false to disable remote VPS operations in production.
CFDNS_ENABLE_SSH=true

# GitHub SSH access is a separate, production-only feature. The self-host installer
# generates this dedicated key pair and seeds verified GitHub host keys.
CFDNS_ENABLE_GITHUB_SSH=true
GITHUB_SSH_KEY_PATH=/var/lib/cfdns-manager/ssh/github_ed25519
GITHUB_SSH_KNOWN_HOSTS=/var/lib/cfdns-manager/ssh/known_hosts

# OAuth administrators must match one of these comma-separated allowlists.
# The local API_KEY owner is the bootstrap administrator and must exchange the key for a session.
ADMIN_EMAILS=
ADMIN_OPEN_IDS=
# Optional exact client IPs, comma-separated. Leave empty to allow any IP.
ADMIN_IP_ALLOWLIST=

# Limit the host file browser to explicit roots. Defaults to the app working directory if unset.
FILE_MANAGER_ROOTS=/var/www,/opt/cfdns-manager

# Prefer API_KEY_FILE for a private on-disk key outside FILE_MANAGER_ROOTS.
API_KEY_FILE=/var/lib/cfdns/.xcm_key
# Optional initial/bootstrap fallback when the configured key file does not yet exist.
API_KEY=replace-with-a-long-random-access-key
